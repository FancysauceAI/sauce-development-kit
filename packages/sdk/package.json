{
  "name": "@fancysauce/sdk",
  "version": "0.2.0",
  "description": "Attribute AI usage and cost to customers, products, and features — OpenTelemetry-native.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/FancysauceAI/sauce-development-kit#readme",
  "bugs": {
    "url": "https://github.com/FancysauceAI/sauce-development-kit/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "cost",
    "attribution",
    "opentelemetry",
    "openai",
    "anthropic",
    "vercel-ai-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FancysauceAI/sauce-development-kit.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./vercel": {
      "import": {
        "types": "./dist/vercel.d.ts",
        "default": "./dist/vercel.js"
      },
      "require": {
        "types": "./dist/vercel.d.cts",
        "default": "./dist/vercel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/otlp-exporter-base": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@traceloop/instrumentation-anthropic": "^0.27.0",
    "@traceloop/instrumentation-openai": "^0.27.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": false
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": false
    },
    "@traceloop/instrumentation-anthropic": {
      "optional": true
    },
    "@traceloop/instrumentation-openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@traceloop/instrumentation-anthropic": "^0.27.0",
    "@traceloop/instrumentation-openai": "^0.27.0",
    "@types/node": "^26.6.3",
    "ai": "7.0.128",
    "openai": "^7.23.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
