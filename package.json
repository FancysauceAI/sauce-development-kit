{
  "name": "sauce-development-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Fancysauce SDK for TypeScript — attribute AI usage and cost to your customers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FancysauceAI/sauce-development-kit"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" --if-present typecheck",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check:internal-refs": "node scripts/check-internal-refs.mjs",
    "changeset": "changeset",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
